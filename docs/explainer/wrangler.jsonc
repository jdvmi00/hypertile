{
  "name": "hypertile",
  "account_id": "852ed8777ba31308faaa8aa37faae01c",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "hypertile-media" }
  ]
}
