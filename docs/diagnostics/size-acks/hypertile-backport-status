#!/usr/bin/env bash
# Read-only check of the temporary Hyprland mirror backports.
set -uo pipefail

backports=/usr/share/hyprland/backports
issues=()
installed=$(pacman -Q hyprland 2>/dev/null || true)
printf 'Installed: %s\n' "${installed:-Hyprland not found}"

# Upstream 0.57.0 fixed the size-ack and mirror-workspace bugs, so only these remain.
check_backport() {
  local name=$1 absent=$2 marker=$backports/$1
  if [[ ! -r "$marker.version" || ! -r "$marker.patch" ]]; then
    issues+=("$absent")
  elif [[ $(cat "$marker.version") != "$installed" ]]; then
    issues+=("The $name marker does not match the installed package; reinstall or investigate.")
  else
    printf '%s marker: %s\n' "$name" "$(cat "$marker.version")"
  fi
}
check_backport mirror-outputs "The mirror-output backport is absent. Check whether this package fixes promotion of displays connected as mirrors before rebuilding or retiring the backport."
check_backport mirror-disconnect "The mirror-disconnect backport is absent. Check whether this package safely handles expired mirrors and source removal before rebuilding or retiring the backport."

if [[ -r "$backports/dependencies" ]]; then
  while read -r package built_version; do
    current=$(pacman -Q "$package" 2>/dev/null || true)
    if [[ "$current" != "$package $built_version" ]]; then
      issues+=("Library package changed: $package (built with $built_version; now ${current:-missing}). Review/rebuild against the updated system before restarting Hyprland.")
    fi
  done < "$backports/dependencies"
elif [[ -r "$backports/mirror-disconnect.version" ]]; then
  issues+=("Build dependency record is missing; compatibility has not been checked.")
fi

if [[ -x /usr/bin/Hyprland ]]; then
  linkage=$(ldd /usr/bin/Hyprland 2>&1)
  if [[ $? != 0 || "$linkage" == *'not found'* ]]; then
    issues+=("Hyprland has a dynamic-library loading problem. Repair the package before logging out or rebooting: $linkage")
  fi
  running=0
  while read -r pid; do
    [[ -n "$pid" ]] || continue
    running=1
    if ! cmp -s "/proc/$pid/exe" /usr/bin/Hyprland; then
      issues+=("Running Hyprland (PID $pid) differs from the installed binary. Save your work and start a new desktop session after package checks pass; hyprctl reload is insufficient.")
    fi
  done < <(pgrep -u "$(id -u)" -x Hyprland || true)
  (( running )) || printf 'No Hyprland process is running for this user.\n'
fi

if (( ${#issues[@]} )); then
  printf '\nREVIEW NEEDED:\n'
  printf -- '- %s\n' "${issues[@]}"
  printf '\nGuides: docs/diagnostics/hyprland-0.57.0/README.md, docs/diagnostics/mirror-outputs/README.md and docs/diagnostics/mirror-disconnect/README.md in the Hypertile checkout.\n'
  if [[ ${1:-} == --notify ]] && command -v notify-send >/dev/null; then
    notify-send -u critical 'Hyprland backports need review' \
      'Run hypertile-backport-status. An update, library change, or pending desktop restart needs attention.' || true
  fi
  exit 1
fi
printf 'Local backports present; tracked libraries unchanged; running binary matches when present.\n'
printf 'This checks package state, not end-to-end reproduction of the bugs.\n'
